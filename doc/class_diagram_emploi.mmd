classDiagram
    direction LR

    %% ===== Enumerations =====
    class Sexe {
        <<enumeration>>
        HOMME
        FEMME
        TOTAL
    }
    class TypeClassification {
        <<enumeration>>
        AGE
        OCCUPATION
    }
    class StatutImport {
        <<enumeration>>
        EN_COURS
        SUCCES
        ECHEC
    }

    %% ===== Classes du domaine de l'emploi (attributs, constructeur, methodes) =====
    class Indicateur {
        +str code_indicateur
        +str description
        +str unite
        +str source
        +bool actif
        +__init__(code_indicateur, description, unite, source, actif)
        +lister() List~Indicateur~
        +trouver_par_code(code_indicateur) Indicateur
        +creer(indicateur) Indicateur
    }
    class Pays {
        +str code_pays
        +str nom_pays
        +__init__(code_pays, nom_pays)
        +lister() List~Pays~
        +trouver_par_code(code_pays) Pays
        +creer(pays) Pays
    }
    class Classification {
        +str code
        +str libelle
        +TypeClassification type
        +__init__(code, libelle, type)
        +lister(type) List~Classification~
        +trouver_par_code(code) Classification
        +creer(classification) Classification
    }
    class Age {
        +int age_min
        +int age_max
        +__init__(code, libelle, age_min, age_max)
    }
    class Occupation {
        +str valeur
        +__init__(code, libelle, valeur)
    }
    class Observation {
        +int id
        +str code_indicateur
        +str code_pays
        +str periode
        +float valeur
        +Sexe sexe
        +str code_classification
        +int import_id
        +str source
        +datetime date_import
        +__init__(id, code_indicateur, code_pays, periode, valeur, sexe, code_classification, import_id, source, date_import)
        +inserer_ou_mettre_a_jour_par_lot(observations) int
        +lire_serie(code_indicateur, code_pays, sexe, code_classification) List~Observation~
        +lire_par_periode(code_indicateur, periode, codes_pays) List~Observation~
        +rechercher(filtres) List~Observation~
        +trouver_par_id(id) Observation
        +modifier(observation) bool
        +supprimer(id) bool
    }
    class ImportDonnees {
        +int id
        +str indicateur_code
        +int utilisateur_id
        +datetime date_debut
        +datetime date_fin
        +StatutImport statut
        +int nombre_lignes
        +str fichier_source
        +str message_erreur
        +__init__(id, indicateur_code, utilisateur_id, date_debut, date_fin, statut, nombre_lignes, fichier_source, message_erreur)
        +creer(import_donnees) ImportDonnees
        +mettre_a_jour(import_donnees) bool
        +lister() List~ImportDonnees~
    }

    %% ===== Heritage =====
    Classification <|-- Age
    Classification <|-- Occupation

    %% ===== Associations entre classes =====
    Observation "0..*" --> "1" Indicateur : concerne
    Observation "0..*" --> "1" Pays : porte sur
    Observation "0..*" --> "0..1" Classification : ventile
    Observation "0..*" --> "1" ImportDonnees : issue de
    ImportDonnees "0..*" --> "1" Indicateur : importe

    %% ===== Usage des enumerations =====
    Observation ..> Sexe
    Classification ..> TypeClassification
    ImportDonnees ..> StatutImport
